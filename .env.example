# Environment Variables
# Copy this to .env.local and fill in your HuggingFace Space URL

# Server-side only — used by the /api/analyze proxy route.
# Intentionally NOT prefixed with NEXT_PUBLIC_ so the backend URL is never
# exposed to the browser; the proxy at /api/analyze is the only caller.
# Example: https://your-username-dermwise.hf.space
HF_SPACE_URL=
