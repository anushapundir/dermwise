# Environment Variables
# Copy this to .env.local and fill in your HuggingFace Space URL

# The URL of your deployed HuggingFace Spaces Gradio app
# Example: https://your-username-dermwise.hf.space
NEXT_PUBLIC_HF_SPACE_URL=

# Server-side only — used by the /api/analyze proxy route
# Same URL as above, but not exposed to the browser
HF_SPACE_URL=
